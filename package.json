{
  "name": "daystar-accommodation-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Daystar University student accommodation finder",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run seed",
    "seed": "node db/seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  }
}
