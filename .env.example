# Copy to .env and fill in. Never commit .env.
PORT=3000

# MySQL (Docker container, localhost only)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=daystar_accommodation
DB_USER=daystar_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Login sessions are stored in MySQL (random cookie token, hash stored), so no signing secret is needed.
# Set NODE_ENV=production when serving over https so the login cookie is marked Secure.
# NODE_ENV=production

# Seeded admin account (password is hashed by db/seed.js)
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional: AI-assisted search on the browse page. Leave GEMINI_API_KEY empty and the AI box simply does not appear.
# The key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # optional: any Gemini model that supports generateContent
# AI_SEARCH_LIMIT_PER_HOUR=30          # optional: AI searches allowed per visitor per hour
