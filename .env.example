# CampusNest settings. Copy this file to a new file named exactly ".env" in the same folder, then fill in the values.
# - ".env" must be plain UTF-8 text (VS Code: check the bottom-right says UTF-8). On Windows make sure it is not ".env.txt".
# - Never commit ".env": it holds passwords. This example file only has placeholders.
# - If a value contains spaces or a "#", put it in double quotes.
# See README.md for the full setup.

# Port the website runs on: http://localhost:3000
PORT=3000

# Database: MariaDB from XAMPP, running on this computer.
# Use 127.0.0.1 and not "localhost": Node may try the IPv6 address first, which XAMPP does not listen on.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=daystar_accommodation
DB_USER=daystar_app
# The password you chose for the daystar_app database user (README: "Create the database and the application user").
DB_PASSWORD=change-me

# Login sessions are stored in the database (a random cookie token, only its hash is saved), so no signing secret is needed.
# Set NODE_ENV=production when the site is served over https, so the login cookie is marked Secure.
# NODE_ENV=production

# The single admin account. "npm run seed" creates it and stores only a bcrypt hash of the password.
# Choose your own address and a password of at least 8 characters. The tests log in with it too (against the test database).
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Automated tests (npm test) use their OWN database and never DB_NAME above. Create it once (README.md, "Testing").
# The name must end in _test and must differ from DB_NAME, or the tests refuse to run. Use a separate user and password.
# TEST_DB_HOST and TEST_DB_PORT are optional (default 127.0.0.1 and 3306).
TEST_DB_NAME=daystar_accommodation_test
TEST_DB_USER=daystar_test
TEST_DB_PASSWORD=change-me

# Optional: AI-assisted search on the browse page. Leave GEMINI_API_KEY empty and the AI box simply does not appear.
# The key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # optional: any Gemini model that supports generateContent
# AI_SEARCH_LIMIT_PER_HOUR=30          # optional: AI searches allowed per visitor per hour
