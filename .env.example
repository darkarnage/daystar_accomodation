# Copy to .env and fill in. Never commit .env.
PORT=3000

# MySQL (Docker container, localhost only)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=daystar_accommodation
DB_USER=daystar_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Used later for login cookies
JWT_SECRET=change-me-to-a-long-random-string

# Seeded admin account (password is hashed by db/seed.js)
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional, only for the Gemini enhancement later
GEMINI_API_KEY=
